generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  role         Role
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isActive     Boolean       @default(true)
  accounts     Account[]
  invites      Invite[]      @relation("UserInvites")
  leads        Lead[]        @relation("LeadOwner")
  sessions     Session[]
  activityLogs ActivityLog[] @relation("UserActivityLogs")

  Lead Lead[] @relation("LeadDeleter")
}

model Lead {
  id            String          @id @default(cuid())
  name          String
  email         String
  phone         String?
  source        String?
  notes         String?
  priority      LeadPriority    @default(MEDIUM)
  onboarded     Boolean         @default(false)
  followUpDate  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  ownerId       String
  stageId       String
  statusId      String
  address       String?
  inputedStatus String?
  nextFollowUp  DateTime?
  service       String?
  assets        String          @default("")
  followUps     FollowUp[]
  owner         User            @relation("LeadOwner", fields: [ownerId], references: [id])
  stage         LeadStage       @relation(fields: [stageId], references: [id])
  status        LeadStatusModel @relation(fields: [statusId], references: [id])
  activityLogs  ActivityLog[]   @relation("LeadActivityLogs")
isDeleted    Boolean   @default(false)
deletedAt    DateTime?
deletedById  String?
deleteReason String?

// Add relation:
deletedBy    User?     @relation("LeadDeleter", fields: [deletedById], references: [id])
}

model DeletionAudit {
  id           String   @id @default(cuid())
  leadId       String
  leadName     String
  leadEmail    String
  deletedById  String
  deletedByName String
  deleteReason String
  deletedAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  
  @@map("deletion_audits")
}

model LeadStage {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model LeadStatusModel {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model FollowUp {
  id        String   @id @default(cuid())
  date      DateTime
  notes     String?
  leadId    String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model Invite {
  id          String       @id @default(uuid())
  email       String
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  invitedBy   User         @relation("UserInvites", fields: [invitedById], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, providerAccountId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leadId    String?
  userId    String
  lead      Lead?     @relation("LeadActivityLogs", fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

enum Role {
  USER
  ADMIN
  SALES
  PDM
  CUSTOMER_CARE
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}
